{
  "info": {
    "name": "Event Management API",
    "_postman_id": "event-management-api-collection",
    "description": "Complete API collection for Event Management System with authentication, events, registrations, and analytics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('admin_id', response.userId);",
                  "    pm.test('Admin registered successfully', function() {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.message).to.include('successfully');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new admin user"
          },
          "response": []
        },
        {
          "name": "1.2 Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('user_id', response.userId);",
                  "    pm.test('User registered successfully', function() {",
                  "        pm.expect(response.success).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"user123\",\n  \"role\": \"User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new regular user"
          },
          "response": []
        },
        {
          "name": "1.3 Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', response.token);",
                  "    pm.test('Admin logged in successfully', function() {",
                  "        pm.expect(response.token).to.be.a('string');",
                  "        pm.expect(response.role).to.equal('Admin');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as admin and save token"
          },
          "response": []
        },
        {
          "name": "1.4 Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('user_token', response.token);",
                  "    pm.test('User logged in successfully', function() {",
                  "        pm.expect(response.token).to.be.a('string');",
                  "        pm.expect(response.role).to.equal('User');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as regular user and save token"
          },
          "response": []
        },
        {
          "name": "1.5 Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout user (blacklist token)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Events (Admin)",
      "item": [
        {
          "name": "2.1 Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('event_id', response.event._id);",
                  "    pm.test('Event created successfully', function() {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.event).to.have.property('_id');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tech Conference 2025\",\n  \"description\": \"Annual technology conference\",\n  \"date\": \"2025-12-15T10:00:00.000Z\",\n  \"location\": \"New York\",\n  \"maxAttendees\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Create a new event (Admin only)"
          },
          "response": []
        },
        {
          "name": "2.2 Update Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Tech Conference 2025\",\n  \"description\": \"Updated description\",\n  \"maxAttendees\": 150\n}"
            },
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}"]
            },
            "description": "Update an event (Admin only)"
          },
          "response": []
        },
        {
          "name": "2.3 Delete Event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}"]
            },
            "description": "Delete an event (Admin only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Events (Public Access)",
      "item": [
        {
          "name": "3.1 Get All Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Get all events"
          },
          "response": []
        },
        {
          "name": "3.2 Get Events by Date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events?date=2025-12-15",
              "host": ["{{base_url}}"],
              "path": ["events"],
              "query": [
                {
                  "key": "date",
                  "value": "2025-12-15"
                }
              ]
            },
            "description": "Filter events by date"
          },
          "response": []
        },
        {
          "name": "3.3 Get Events by Location",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events?location=New York",
              "host": ["{{base_url}}"],
              "path": ["events"],
              "query": [
                {
                  "key": "location",
                  "value": "New York"
                }
              ]
            },
            "description": "Filter events by location"
          },
          "response": []
        },
        {
          "name": "3.4 Get Event by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}"]
            },
            "description": "Get a single event by ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Event Registration",
      "item": [
        {
          "name": "4.1 Register for Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration successful', function() {",
                  "    if (pm.response.code === 201) {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.message).to.include('Successfully registered');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}/register",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}", "register"]
            },
            "description": "Register the authenticated user for an event"
          },
          "response": []
        },
        {
          "name": "4.2 Cancel Registration",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}/register",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}", "register"]
            },
            "description": "Cancel registration for an event"
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Analytics (Admin Only)",
      "item": [
        {
          "name": "5.1 Get Events Per Month",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/analytics/events-per-month",
              "host": ["{{base_url}}"],
              "path": ["analytics", "events-per-month"]
            },
            "description": "Get events count per month for current year (Admin only)"
          },
          "response": []
        },
        {
          "name": "5.2 Get Top 3 Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/analytics/top-events",
              "host": ["{{base_url}}"],
              "path": ["analytics", "top-events"]
            },
            "description": "Get top 3 events by registration count (Admin only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Error Testing",
      "item": [
        {
          "name": "6.1 No Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Test: Access without token (should return 401)"
          },
          "response": []
        },
        {
          "name": "6.2 User Creates Event (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Event\",\n  \"date\": \"2025-12-20T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Test: Regular user trying to create event (should return 403)"
          },
          "response": []
        },
        {
          "name": "6.3 Missing Title (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Event without title\",\n  \"date\": \"2025-12-20T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/events",
              "host": ["{{base_url}}"],
              "path": ["events"]
            },
            "description": "Test: Create event without title (should return 400)"
          },
          "response": []
        },
        {
          "name": "6.4 Already Registered (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/{{event_id}}/register",
              "host": ["{{base_url}}"],
              "path": ["events", "{{event_id}}", "register"]
            },
            "description": "Test: Try to register twice (should return 400)"
          },
          "response": []
        },
        {
          "name": "6.5 Invalid Event ID (500/404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/invalidid123",
              "host": ["{{base_url}}"],
              "path": ["events", "invalidid123"]
            },
            "description": "Test: Get event with invalid ID"
          },
          "response": []
        }
      ]
    }
  ]
}
